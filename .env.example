DATABASE_URL="mysql://root:@127.0.0.1:3306/amstools"
# Required. Production refuses to start when this is missing, shorter than 32
# characters, or still the example value below. Local development may keep the
# example. Generate a real one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
APP_URL="http://localhost:3000"
SEED_ADMIN_EMAIL="admin@amstools.local"
# Password for the super admin created by `npm run db:seed`.
# Local development may keep ChangeMe123!.
# Production (NODE_ENV=production) refuses to seed that example password.
# Set a different SEED_ADMIN_PASSWORD before seeding on the server.
SEED_ADMIN_PASSWORD="ChangeMe123!"
